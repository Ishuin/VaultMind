# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# Set to 'true' for local development to bypass authentication (DO NOT USE IN PRODUCTION)
# VITE_SUPABASE_BYPASS_REDIRECTS=false

# Stripe Configuration (replace with your live/test keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51XYZ...
VITE_STRIPE_STANDARD_PLAN_ID=price_1XYZ...
VITE_STRIPE_PREMIUM_PLAN_ID=price_1XYZ...
VITE_STRIPE_PRO_MONTHLY_PLAN_ID=price_1XYZ...
VITE_STRIPE_WEBHOOK_SECRET=whsec_XYZ...

# API Configuration
VITE_API_URL=your_api_url
