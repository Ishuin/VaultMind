PROJECT_NAME="ThoughtWeb Navigator"
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# PostgreSQL connection (the docker-compose.yml db service maps to 5433)
DATABASE_URL="postgresql://postgres:password@localhost:5433/thoughtweb_navigator"

# Ollama runs on the host machine
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"

# LanceDB vector store (local directory)
LANCEDB_URI="./.lancedb"

# Optional: Razorpay payment keys, NVIDIA NIM API key, SendGrid for emails
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NVIDIA_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL="noreply@vaultmind.app"
FRONTEND_URL="http://localhost:8080"

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_USER_STORAGE_MB=5000