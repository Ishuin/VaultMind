PROJECT_NAME="ThoughtWeb Navigator"
BACKEND_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# PostgreSQL connection (the docker-compose.yml db service maps to 5433)
DATABASE_URL="postgresql://postgres:password@localhost:5433/thoughtweb_navigator"

# Ollama runs on the host machine
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:1b"

# LanceDB vector store (local directory)
LANCEDB_URI="./.lancedb"

# Optional: Razorpay payment keys, NVIDIA NIM API key, SendGrid for emails
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NVIDIA_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL="noreply@vaultmind.app"
FRONTEND_URL="http://localhost:8080"

# BYOK providers (env fallback only - per-user keys are stored encrypted in Postgres)
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Optional: explicit Fernet key for encrypting stored user API keys
# (derived from SECRET_KEY when unset)
LLM_KEYS_FERNET_KEY=

# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_USER_STORAGE_MB=5000