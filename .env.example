# =============================================================================
# ThoughtWeb Navigator — Root-level environment variables for Docker Compose
# Copy this file to .env and fill in your real values.
# NEVER commit .env with real secrets to version control.
# =============================================================================

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=thoughtweb_navigator

# ── Frontend build arg ───────────────────────────────────────────────────────
# The URL browsers use to reach the FastAPI API.
# In production: replace with your real domain (e.g. https://api.myapp.com)
VITE_API_URL=http://localhost:8000
