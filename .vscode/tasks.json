{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run FastAPI Backend",
            "type": "shell",
            "command": "cd backend_fastapi; .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --port 8000 --host 127.0.0.1",
            "presentation": {
                "group": "product",
                "reveal": "always",
                "panel": "new",
                "clear": true
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Started server process",
                    "endsPattern": "Uvicorn running on"
                }
            }
        },
        {
            "label": "Run Vite Frontend",
            "type": "shell",
            "command": "cd thoughtweb-navigator; npm run dev",
            "presentation": {
                "group": "product",
                "reveal": "always",
                "panel": "new",
                "clear": true
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^.*$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "VITE v",
                    "endsPattern": "ready in"
                }
            }
        },
        {
            "label": "Run Full Product",
            "dependsOn": [
                "Run FastAPI Backend",
                "Run Vite Frontend"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
